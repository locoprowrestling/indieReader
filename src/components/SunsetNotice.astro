---
import { withBase } from "../lib/base";

const patreonUrl = "https://www.patreon.com/cw/LoCoProWrestling";
---

<section class="sunset-notice" aria-labelledby="sunset-title">
  <div class="sunset-copy">
    <p class="sunset-date">Sunsetting Monday, July 6th, 2026</p>
    <h1 id="sunset-title">indieReader is signing off.</h1>
    <p>
      Thank you for exploring the world of indie wrestling with us. These tools
      are quite expensive to maintain and were not generating any revenue to
      support our wrestlers.
    </p>
    <p>
      If you would like to support our cause, head over to LoCo Pro Wrestling on
      Patreon and join us there.
    </p>
    <div class="sunset-actions">
      <a class="button-primary" href={patreonUrl}>Join our Patreon</a>
      <a class="button-secondary" href={withBase("/")}>Return home</a>
    </div>
  </div>
</section>

<style>
  .sunset-notice {
    min-height: min(48rem, calc(100vh - 11rem));
    display: grid;
    place-items: center;
    padding: clamp(2rem, 7vw, 5rem);
    border-radius: var(--radius-panel);
    background:
      radial-gradient(circle at 50% 0%, var(--hero-radial), transparent 34%),
      linear-gradient(180deg, var(--hero-start) 0%, var(--hero-end) 100%);
    border: 1px solid var(--hero-border);
    box-shadow: var(--shadow);
    text-align: center;
  }

  .sunset-copy {
    max-width: 44rem;
    display: grid;
    gap: 1.15rem;
    justify-items: center;
  }

  .sunset-date {
    margin: 0;
    color: var(--accent-link);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: var(--text);
    font-size: clamp(3rem, 8vw, 5.6rem);
    font-weight: 650;
    letter-spacing: 0;
    line-height: 1.02;
  }

  p {
    margin: 0;
    color: var(--text-muted);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.55;
  }

  .sunset-actions {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 0.65rem;
  }

  @media (max-width: 560px) {
    .sunset-notice {
      min-height: calc(100vh - 12rem);
      padding: 2rem 1.15rem;
    }

    .sunset-actions {
      width: 100%;
    }

    .sunset-actions a {
      width: 100%;
    }
  }
</style>
